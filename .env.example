# Copy this file to .env and fill in values from your Supabase project's
# Settings > API page (https://supabase.com/dashboard/project/_/settings/api).
#
# VITE_SUPABASE_PUBLISHABLE_KEY is the anon/public key -- safe to ship to the
# browser, it is subject to Row Level Security. Never put the service_role
# key in this file or anywhere in the frontend.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-key
